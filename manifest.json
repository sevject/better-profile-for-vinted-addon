{
  "manifest_version": 3,
  "name": "Better Profile for Vinted",
  "version": "1.0.0",
  "description": "Shows title, brand, size and condition under your items on your own Vinted profile, next to the views and favourites.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-profile-for-vinted@addon",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.de/*",
        "https://www.vinted.at/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.lv/*",
        "https://www.vinted.ee/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.se/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.hr/*",
        "https://www.vinted.gr/*",
        "https://www.vinted.ie/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
